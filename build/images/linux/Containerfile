# syntax=docker/dockerfile:1.7
# Aurora builder image · Linux x86-64 (supported)
#
# Built and published only by a deliberately triggered, reviewed workflow or
# by tools/build-builder-image.sh. This image contains a build toolchain and
# the engine source at one version; it is not an engine release.

FROM rust:1.99.1-bookworm

ARG AURORA_VERSION=0.1.0

LABEL org.opencontainers.image.title="Aurora game builder"
LABEL org.opencontainers.image.description="Builds Aurora game packages for Linux x86-64 inside a container"
LABEL org.opencontainers.image.version="${AURORA_VERSION}"
LABEL org.aurora.target="linux-x86_64"
LABEL org.aurora.triple="x86_64-unknown-linux-gnu"
LABEL org.aurora.features=""
LABEL org.aurora.abiversion="1"
LABEL org.aurora.engine_version="${AURORA_VERSION}"
LABEL org.aurora.toolchain.rust="1.99.1"
LABEL org.aurora.toolchain.scriptc="0.4.16"
LABEL org.aurora.toolchain.bun="1.2.22"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        curl \
        file \
        g++ \
        libasound2-dev \
        libudev-dev \
        libwayland-dev \
        libxkbcommon-dev \
        pkg-config \
        tar \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 10001 --create-home --shell /bin/bash builder

WORKDIR /opt/aurora
COPY --chown=builder:builder . /opt/aurora
COPY build/images/aurora-container-build.sh /usr/local/bin/aurora-container-build
RUN chmod 0755 /usr/local/bin/aurora-container-build

USER builder
ENV HOME=/home/builder

# Fetch and build once so game builds never need network access.
RUN cargo fetch --locked
RUN cargo build --locked --release --bin aurora-editor --bin aurora-player
RUN tools/setup.sh

ENTRYPOINT ["/usr/local/bin/aurora-container-build"]
